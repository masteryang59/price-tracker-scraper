# Where price history is stored
DB_PATH=data/prices.db
# Used when a page has a price but no currency
DEFAULT_CURRENCY=USD

# Scraping
HEADLESS=true
PAGE_TIMEOUT_SECONDS=30
# Each retry uses a different browser identity, with exponential backoff
MAX_ATTEMPTS=3
CONCURRENCY=3
# Minimum gap between two requests to the same site (plus up to 50% jitter)
MIN_DOMAIN_DELAY_SECONDS=2
RESPECT_ROBOTS_TXT=true

# Alerts: a drop of at least this many percent, or reaching a product's target price
MIN_DROP_PERCENT=1
# Leave empty to skip email alerts
ALERT_EMAIL_TO=you@example.com
FROM_EMAIL=price-tracker@example.com
# Slack-style incoming webhook (posts {"text": ...}); leave empty to skip
ALERT_WEBHOOK_URL=

# SMTP. Leave SMTP_HOST empty to write emails to ./outbox as .eml files.
# docker compose overrides these to use the bundled Mailpit inbox (http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Used by `pricetracker seed-demo`
DEMO_SHOP_URL=http://localhost:8080
ENCODE_TOKEN=enabled
COMPACT_STORAGE=enabled
UPDATE_CACHE=enabled